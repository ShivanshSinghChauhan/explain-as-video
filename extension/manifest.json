{
  "manifest_version": 3,
  "name": "Explain as Video",
  "version": "0.1.0",
  "description": "Turn highlighted text into a short narrated explainer video. Works offline in Demo mode; optional Gemini free tier.",
  "minimum_chrome_version": "116",
  "permissions": ["contextMenus", "storage", "activeTab", "scripting"],
  "optional_host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Explain selected text as a video",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "commands": {
    "explain-selection": {
      "suggested_key": { "default": "Alt+Shift+E" },
      "description": "Explain the selected text as a video"
    }
  },
  "options_page": "src/options/options.html",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
